{
  "name": "nook",
  "version": "0.1.0",
  "private": true,
  "description": "Nook — app xã hội camera-first. Kho gộp: shared + backend. Frontend đứng riêng (Expo có luật gói riêng).",
  "workspaces": [
    "shared",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install && npm --prefix frontend install",
    "build:shared": "npm run build -w @nook/shared",
    "dev": "node setup/dev.mjs",
    "tunnel": "node setup/tunnel.mjs",
    "dev:shared": "npm run dev -w @nook/shared",
    "dev:be": "npm run dev -w @nook/backend",
    "dev:fe": "npm --prefix frontend run dev",
    "check": "npm run typecheck -w @nook/shared && npm run check -w @nook/backend",
    "check:fe": "npm --prefix frontend run check",
    "up": "docker compose -f backend/docker/compose.dev.yml up -d",
    "up:search": "docker compose -f backend/docker/compose.dev.yml --profile search up -d",
    "down": "docker compose -f backend/docker/compose.dev.yml --profile search down",
    "logs": "docker compose -f backend/docker/compose.dev.yml logs -f",
    "reset:db": "docker compose -f backend/docker/compose.dev.yml down -v && docker compose -f backend/docker/compose.dev.yml up -d",
    "stack:up": "docker compose -f backend/docker/compose.yml up -d --build",
    "stack:down": "docker compose -f backend/docker/compose.yml down",
    "stack:logs": "docker compose -f backend/docker/compose.yml logs -f",
    "docker:build": "docker build -f backend/Dockerfile -t nook-api:local .",
    "migration:run": "npm run migration:run -w @nook/backend",
    "migration:revert": "npm run migration:revert -w @nook/backend"
  },
  "engines": {
    "node": ">=20.11"
  }
}
