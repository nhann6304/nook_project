{
  "name": "@nook/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hợp đồng giữa app Nook và server Nook: đường dẫn API, mã lỗi, mã thông báo, giới hạn, kiểu dữ liệu, hàm thuần. Không phụ thuộc.",
  "license": "UNLICENSED",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./dist/common/index.js"
    },
    "./common/constant": {
      "types": "./dist/common/constant/index.d.ts",
      "default": "./dist/common/constant/index.js"
    },
    "./common/interface": {
      "types": "./dist/common/interface/index.d.ts",
      "default": "./dist/common/interface/index.js"
    },
    "./common/type": {
      "types": "./dist/common/type/index.d.ts",
      "default": "./dist/common/type/index.js"
    },
    "./common/util": {
      "types": "./dist/common/util/index.d.ts",
      "default": "./dist/common/util/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./model/constant": {
      "types": "./dist/model/constant/index.d.ts",
      "default": "./dist/model/constant/index.js"
    },
    "./model/interface": {
      "types": "./dist/model/interface/index.d.ts",
      "default": "./dist/model/interface/index.js"
    },
    "./model/type": {
      "types": "./dist/model/type/index.d.ts",
      "default": "./dist/model/type/index.js"
    },
    "./model/util": {
      "types": "./dist/model/util/index.d.ts",
      "default": "./dist/model/util/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:layer": "node scripts/check-layer.mjs",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "node scripts/check-layer.mjs && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
