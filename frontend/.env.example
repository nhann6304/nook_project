# Địa chỉ server Nook. Bỏ trống (hoặc không có tệp .env) = app chạy HÀNG GIẢ,
# mã đăng nhập là 123456. Chép thành `.env` rồi điền:
#
#   Máy ảo iOS / chạy web:   http://localhost:4000
#   Máy ảo Android:          http://10.0.2.2:4000
#   Điện thoại thật (Expo Go): http://<IP máy tính trong mạng LAN>:4000
#                              ví dụ http://192.168.1.20:4000
#
# Đổi xong phải chạy lại `npm run dev:clear` — Expo chỉ đọc biến lúc bật.
EXPO_PUBLIC_API_URL=
