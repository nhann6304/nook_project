{
  "expo": {
    "name": "Nook",
    "slug": "nook",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nook",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "backgroundColor": "#151312",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nook.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Nook cần camera để bạn chụp khoảnh khắc gửi cho bạn bè trong góc của mình.",
        "NSPhotoLibraryUsageDescription": "Nook cần thư viện ảnh để bạn chọn một tấm đã chụp sẵn.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nook.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-foreground.png",
        "backgroundColor": "#151312"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Nook cần camera để bạn chụp khoảnh khắc gửi cho bạn bè trong góc của mình."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nook cần thư viện ảnh để bạn chọn một tấm đã chụp sẵn gửi cho bạn bè."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#151312"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
