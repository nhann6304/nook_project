# ─────────────────────────────────────────────────────────────────────────────
#  backend/docker/.env.example — biến cho CẢ CỤM (compose.yml).
#
#      cp backend/docker/.env.example backend/docker/.env
#
#  Một tệp, hai việc: compose đọc nó để điền ${...} trong compose.yml (mật khẩu
#  Postgres, MinIO), và api + migrate nạp nó làm biến môi trường.
#
#  Mọi BÍ MẬT để TRỐNG có chủ ý: thiếu thì compose dừng ngay (`:?`) hoặc server
#  không chịu bật (`validateEnv`), thay vì chạy bằng một chuỗi ai cũng biết.
#  Sinh bằng:
#
#      node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
#  (base64url: không có / + @ — MinIO nhét khoá vào URL, ký tự lạ là hỏng.)
#  Danh sách đủ, kèm lý do từng biến: backend/src/config/env/env.validation.ts
# ─────────────────────────────────────────────────────────────────────────────


# ── Chạy ở đâu ───────────────────────────────────────────────────────────────
# production: log JSON, Swagger bắt buộc tắt, kho ảnh hỏng lúc bật là dừng hẳn.
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:8081

# ĐỊA CHỈ của proxy đứng trước api — chính là `proxy` trong compose.yml (IP cố
# định PROXY_IP bên dưới). ĐỪNG đặt `true` hay một con số: backend/README mục 9.
# Có thêm một tầng TLS phía trước (Caddy, Cloudflare…) thì nối thêm địa chỉ của
# nó, ngăn bằng dấu phẩy.
TRUST_PROXY=172.30.0.10


# ── Cơ sở dữ liệu ────────────────────────────────────────────────────────────
# `db` là tên dịch vụ trong compose. Ba biến USER/PASSWORD/NAME cũng là thứ
# Postgres dùng để tự dựng kho lần đầu.
DB_HOST=db
DB_PORT=5432
DB_USER=nook
DB_PASSWORD=
DB_NAME=nook
DB_LOGGING=false


# ── Redis ────────────────────────────────────────────────────────────────────
# Hàng đợi, mã đăng nhập, cầu socket giữa các bản api, đếm online.
REDIS_URL=redis://redis:6379


# ── Thẻ phiên ────────────────────────────────────────────────────────────────
# Hai chuỗi PHẢI khác nhau, mỗi chuỗi ≥ 16 ký tự (thật thì 48+).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Giây. 900 = 15 phút · 15552000 = 180 ngày KHÔNG mở app.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=15552000


# ── Gửi mã đăng nhập ─────────────────────────────────────────────────────────
# console = mã in ra log (`docker compose -f backend/docker/compose.yml logs api`).
#           Chỉ cho staging nội bộ. Người dùng thật → smtp + SMTP_URL.
CODE_SENDER=console
SMTP_URL=
SMTP_FROM=Nook <hello@nook.app>
# Mã qua SỐ ĐIỆN THOẠI (chỉ di động VN). off | esms | twilio — `console` bị
# chặn khi NODE_ENV=production. eSMS cần brandname + mẫu tin đã duyệt với nhà
# mạng; Twilio thì cần SID + TOKEN và FROM hoặc MESSAGING_SERVICE_SID.
# Xem backend/README mục 1, "Mã qua SMS".
SMS_SENDER=off
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Khoá ký mã 6 số trong Redis — RIÊNG, đừng chép khoá thẻ. ≥ 16 ký tự.
AUTH_CODE_SECRET=
# Hỏi bản ghi MX của tên miền email. Bản thật thì bật.
EMAIL_MX_CHECK=true


# ── Kho ảnh ──────────────────────────────────────────────────────────────────
#
#  App PUT/GET THẲNG vào kho bằng đường đã ký, và chữ ký gắn với tên máy trong
#  STORAGE_ENDPOINT. Nên đây phải là địa chỉ mà CẢ điện thoại LẪN container api
#  cùng tới được — `http://minio:9000` chỉ api thấy, điện thoại thì không:
#
#    MinIO trong cụm này   http://<IP-LAN-hoặc-tên-miền-của-máy>:9000   (MINIO_PORT)
#    Cloudflare R2         https://<account-id>.r2.cloudflarestorage.com
#                          (rồi bỏ hai dịch vụ minio + minio-init khỏi compose)
#
#  Kiểu đường dẫn tự nhận từ tên miền — không có biến nào để đặt sai.
STORAGE_ENDPOINT=http://192.168.1.10:9000
STORAGE_REGION=auto
STORAGE_BUCKET=nook-media
# Với MinIO trong cụm, hai biến này cũng là tài khoản gốc của MinIO (mật khẩu ≥ 8 ký tự).
STORAGE_KEY_ID=nook
STORAGE_SECRET=

# Chỉ khai khi đang CHUYỂN kho (ảnh cũ đọc ở kho cũ) — backend/README mục 4.
# STORAGE_LEGACY_ENDPOINT=
# STORAGE_LEGACY_BUCKET=
# STORAGE_LEGACY_KEY_ID=
# STORAGE_LEGACY_SECRET=


# ── Quản trị ─────────────────────────────────────────────────────────────────
# Email THẬT của người giữ vai root. Migration lẫn server đều đọc. Bỏ trống thì
# migration tạo một chỗ giữ vai `root@nook.local` không ai đăng nhập được.
# ROOT_ADMIN_EMAIL=you@example.com


# ── Log & tài liệu ───────────────────────────────────────────────────────────
LOG_LEVEL=info
# NODE_ENV=production thì BẮT BUỘC false — server không chịu bật nếu bật.
SWAGGER_ENABLED=false


# ── Riêng của compose (server không đọc) ─────────────────────────────────────
# Cổng proxy ra máy chủ · cổng MinIO cho điện thoại · console MinIO (chỉ 127.0.0.1).
HTTP_PORT=80
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Mạng của cụm và IP cố định của proxy — đổi thì đổi cả TRUST_PROXY ở trên.
NOOK_SUBNET=172.30.0.0/24
PROXY_IP=172.30.0.10
# Nhãn image api, để giữ nhiều bản dựng.
NOOK_TAG=local
# Image MinIO (có cả `mc`). Bản gốc minio/minio đã rời Docker Hub — xem compose.yml.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
