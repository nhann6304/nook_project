# Chép file này thành .env rồi sửa. .env KHÔNG được commit.

# ── Chạy ở đâu ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Nơi app gọi tới. Nhiều nguồn thì ngăn bằng dấu phẩy.
APP_ORIGIN=http://localhost:8081,http://localhost:19006

# ── Cơ sở dữ liệu ────────────────────────────────────────────────────────────
# Postgres chạy THẲNG TRÊN MÁY (Homebrew), không qua Docker.
# Dựng lần đầu:
#   createuser nook --login --pwprompt   (mật khẩu: nook)
#   createdb -O nook nook
#
# Muốn dùng Postgres trong Docker thay vì bản trên máy thì:
#   docker compose -f backend/docker/compose.dev.yml --profile db up -d
#   rồi đổi DB_PORT thành 5433 (5432 đã có bản trên máy chiếm).
DB_HOST=localhost
DB_PORT=5432
DB_USER=nook
DB_PASSWORD=nook
DB_NAME=nook
DB_LOGGING=false

# ── Redis ────────────────────────────────────────────────────────────────────
# Cổng 6380 chứ không phải 6379, cùng lý do như trên.
REDIS_URL=redis://localhost:6380

# ── Thẻ phiên ────────────────────────────────────────────────────────────────
# ĐỔI HAI CHUỖI NÀY trước khi lên thật, và hai cái phải KHÁC nhau.
# Sinh nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=doi-chuoi-nay-truoc-khi-len-that
JWT_REFRESH_SECRET=doi-chuoi-nay-nua-va-phai-khac-cai-o-tren
# Tính bằng giây. 900 = 15 phút.
JWT_ACCESS_TTL=900
# 2592000 = 30 ngày.
JWT_REFRESH_TTL=2592000

# ── Gửi mã đăng nhập ─────────────────────────────────────────────────────────
# console = in ra log, không gửi đi đâu cả. Dùng khi dev.
# smtp    = gửi email thật, cần SMTP_URL.
CODE_SENDER=console
SMTP_URL=
SMTP_FROM=Nook <hello@nook.app>

# ── Log & tài liệu ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
# Tắt ở bản thật.
SWAGGER_ENABLED=true
