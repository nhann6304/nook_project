# ─────────────────────────────────────────────────────────────────────────────
#  backend/.env.example — chép nguyên si là chạy được.
#
#      cp backend/.env.example backend/.env
#
#  (Chạy `./setup/mac/run.sh` thì nó tự chép hộ, và còn sinh hai chuỗi ký
#   ngẫu nhiên thay cho hai chuỗi dev bên dưới. Cách đó tốt hơn.)
#
#  MÁY MỚI cần đúng hai thứ: Node 22 hoặc 24, và Docker đang bật.
#  `npm run up` dựng Postgres + Redis + MinIO trong Docker; file này nối sẵn.
# ─────────────────────────────────────────────────────────────────────────────


# ── Chạy ở đâu ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Nơi app gọi tới. Nhiều nguồn thì ngăn bằng dấu phẩy.
# 8081 là Metro của Expo; 19006 là bản chạy trên trình duyệt.
APP_ORIGIN=http://localhost:8081,http://localhost:19006

# ĐỊA CHỈ của proxy đứng TRƯỚC server này. Ngăn bằng dấu phẩy.
#
#   (bỏ trống)   chạy thẳng trên máy, không có proxy  ← để vậy khi dev
#   127.0.0.1    nginx chạy cùng máy
#   10.0.0.0/8   nginx trong mạng nội bộ
#   loopback     tên gọi sẵn, tương đương 127.0.0.1 và ::1
#
# Mọi trần chống bot đếm theo `req.ip`, mà `req.ip` lấy từ header
# `X-Forwarded-For` — header do CLIENT tự gõ. Chỉ có một câu hỏi đáng hỏi: cái
# máy vừa nối tới đây có phải proxy của mình không. ĐỪNG đặt `true` (tin mọi
# hop = kẻ gọi đổi header mỗi lần một giá trị là mọi trần biến mất) và đừng đặt
# một con số (Fastify đã bỏ kiểu đó, đặt số là thành không tin gì cả).
TRUST_PROXY=


# ── Cơ sở dữ liệu ────────────────────────────────────────────────────────────
#
#  MẶC ĐỊNH — Postgres trong Docker (`npm run up`), cổng 5433. Vai, mật khẩu,
#  kho đều là `nook`, container tự dựng lần đầu.
#
#  Máy đã có Postgres cài sẵn muốn dùng bản đó: đổi DB_PORT thành 5432. Vai và
#  kho `nook` do `setup/*/install` tự dựng nếu chưa có.
#
DB_HOST=localhost
DB_PORT=5433
DB_USER=nook
DB_PASSWORD=nook
DB_NAME=nook
# Bật lên để thấy từng câu SQL trong log. Ồn, chỉ bật khi đang truy một chỗ cụ thể.
DB_LOGGING=false


# ── Redis ────────────────────────────────────────────────────────────────────
# Luôn chạy trong Docker (`run.sh` tự kéo lên).
# Cổng 6380 chứ không phải 6379: cổng chuẩn hay bị Redis của dự án khác chiếm.
REDIS_URL=redis://localhost:6380


# ── Thẻ phiên ────────────────────────────────────────────────────────────────
#
#  ⚠ HAI CHUỖI DƯỚI ĐÂY LÀ CHUỖI DEV, NẰM CÔNG KHAI TRÊN GITHUB.
#    Chạy ở máy mình thì dùng thoải mái. Trước khi lên bản thật thì PHẢI sinh
#    lại, và hai cái phải khác nhau:
#
#      node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
JWT_ACCESS_SECRET=dev-only-access-KHONG-DUNG-CHO-BAN-THAT-a1b2c3d4e5f6
JWT_REFRESH_SECRET=dev-only-refresh-KHONG-DUNG-CHO-BAN-THAT-z9y8x7w6v5u4

# Tính bằng giây.
# 900      = 15 phút — thẻ ngắn hạn, đính vào mỗi lần gọi. App tự đổi thẻ mới,
#            người dùng không thấy gì, KHÔNG phải đăng nhập lại.
# 15552000 = 180 ngày KHÔNG mở app. Mỗi lần mở, hạn đẩy ra xa lại từ đầu — nên
#            người dùng thật đăng nhập đúng một lần rồi thôi.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=15552000


# ── Gửi mã đăng nhập ─────────────────────────────────────────────────────────
#
#  console = KHÔNG gửi đi đâu cả, mã in thẳng ra log server:
#
#      WARN [AuthCode] [DEV ONLY] email nam@gmail.com - code: 193167
#
#  smtp    = gửi email thật, phải điền SMTP_URL.
#            Gmail thì bật "App password" rồi:
#            SMTP_URL=smtps://email%40gmail.com:matkhauung@smtp.gmail.com:465
#            (dấu @ trong email phải viết thành %40)
#
#  Biến này CHỈ lo email. Số điện thoại đi đường riêng: SMS_SENDER bên dưới.
#
CODE_SENDER=console
SMTP_URL=
SMTP_FROM=Nook <hello@nook.app>

# Mã qua SỐ ĐIỆN THOẠI (chỉ di động Việt Nam — số nước ngoài bị từ chối để
# chặn kẻ bắn SMS tới dải số đắt tiền).
#
#  off     = đóng đường số điện thoại, xin mã trả `auth.method_unavailable`
#  console = mã in ra log như email ở trên. Bản thật (production) không chịu bật.
#  esms    = eSMS.vn, brandname — rẻ cho số VN. Phải đăng ký brandname và MẪU
#            nội dung với nhà mạng (vài ngày làm việc). Điền ba biến ESMS_*.
#  twilio  = Twilio — dễ bật, nhưng đắt hơn tới VN và nhà mạng VN có thể chặn
#            tên gửi chưa đăng ký. Điền SID + TOKEN và FROM hoặc MESSAGING_SERVICE_SID.
#
#  Xem backend/README mục 1, "Mã qua SMS".
SMS_SENDER=console
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Khoá ký mã 6 số trước khi cất vào Redis. Khoá RIÊNG, đừng chép lại một trong
# hai khoá thẻ ở trên: hai thứ khác vòng đời, đổi khoá thẻ là đăng xuất cả
# thiên hạ, còn đổi khoá này thì cùng lắm mất mấy cái mã đang treo 5 phút.
# Sinh khoá thật bằng lệnh node ở mục thẻ phía trên.
AUTH_CODE_SECRET=dev-only-code-KHONG-DUNG-CHO-BAN-THAT-m5n6b7v8c9x0

# Có hỏi bản ghi MX của tên miền email không — chặn tên miền bịa và phần lớn
# hộp thư dùng một lần chưa có trong danh sách cứng.
#
# TẮT khi dev, và đó là chủ ý: bốn bài smoke gọi bằng `@nook.test`, tên miền
# không có thật nên không có MX. Bật lên là cả bốn bài đỏ. Bản thật thì bật.
EMAIL_MX_CHECK=false


# ── Tìm kiếm (Elasticsearch) ─────────────────────────────────────────────────
#
#  TẮT khi dev: tìm kiếm lùi về Postgres, không cần ES. Muốn thử ES thật:
#      docker compose -f backend/docker/compose.dev.yml --profile search up -d
#  rồi đặt SEARCH_ENABLED=true và chạy `npm run search:reindex -w @nook/backend`.
SEARCH_ENABLED=false
ELASTIC_URL=http://localhost:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=nook-elastic-dev


# ── Kho ảnh ──────────────────────────────────────────────────────────────────
#
#  Máy dev dùng MinIO trong Docker; bản thật dùng Cloudflare R2. Cả hai nói
#  cùng giao thức S3 nên đường tải lên ở máy dev là ĐƯỜNG THẬT.
#
#  Không phải khai kiểu đường dẫn: server tự nhận ra từ tên miền (MinIO cần
#  http://host/bucket/key, R2 cần https://bucket.host/key). Đó là cái bẫy đắt
#  nhất của S3 — đặt sai thì mọi lần tải lên trả 403 hoặc 404 mà không nói vì sao.
#
#  ĐỔI KHO về sau (MinIO -> R2): mỗi dòng ảnh nhớ nó nằm ở kho nào, nên chỉ cần
#  trỏ bốn biến trên sang kho mới và khai thêm bốn biến LEGACY dưới đây để đọc
#  kho cũ. Ảnh mới vào kho mới, ảnh cũ đọc ở kho cũ, chép dần sang lúc rảnh —
#  không dừng dịch vụ, không mất tấm nào. Chép xong thì bỏ khối LEGACY đi.
#
#  Ảnh GỐC không bao giờ bị bóp, không bao giờ bị xoá. Xem backend/README mục 8.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=nook-media
STORAGE_KEY_ID=nook
STORAGE_SECRET=nook12345

# Chỉ khai khi đang chuyển kho:
# STORAGE_LEGACY_ENDPOINT=
# STORAGE_LEGACY_BUCKET=
# STORAGE_LEGACY_KEY_ID=
# STORAGE_LEGACY_SECRET=

# ── Quản trị ─────────────────────────────────────────────────────────────────
#
#  Email của tài khoản quản trị gốc. Không có API nào phong 'root' — người đầu
#  tiên phải tới từ bên ngoài hệ thống, nếu không thì gà và trứng.
#
#  Bỏ trống cũng chạy: migration đã tạo sẵn một tài khoản gốc với email
#  root@nook.local. Địa chỉ đó không có thật nên không ai đăng nhập vào nó được
#  — nó là chỗ giữ vai, không phải một lối vào. Khai email THẬT của bạn vào đây
#  rồi bật server là vai gốc chuyển sang tài khoản đó.
#
#  Tài khoản vai 'root' KHÔNG XOÁ ĐƯỢC — có trigger chặn ngay trong cơ sở dữ liệu.
ROOT_ADMIN_EMAIL=

# ── Log & tài liệu ───────────────────────────────────────────────────────────
# debug ở máy dev; bản thật để info hoặc warn.
LOG_LEVEL=debug
# Trang Swagger ở /docs. Bản thật BẮT BUỘC để false — server không chịu bật nếu
# NODE_ENV=production mà cờ này vẫn true.
SWAGGER_ENABLED=true
